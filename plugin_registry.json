{
  "version": 1,
  "description": "小狸 CLI 插件码注册表 - 通过 /plugin install <插件码> 安装",
  "plugins": {
    "dglab": {
      "name": "DG-Lab 郊狼 WebSocket 控制",
      "description": "基于 DG-LAB-OPENSOURCE 官方 Socket V2 协议，支持郊狼 3.0 脉冲主机远程控制",
      "author": "xiaoli-cli-plugins",
      "version": "1.0.0",
      "file": "dglab_ws.py",
      "url": "https://gitee.com/shuiyu1123/xiaoli-cli-plugins/raw/master/dglab_ws/dglab_ws.py",
      "docs": "https://gitee.com/shuiyu1123/xiaoli-cli-plugins/raw/master/dglab_ws/README.md",
      "deps": [
        "websocket-client"
      ],
      "optional_deps": [
        "qrcode"
      ],
      "keywords": [
        "dg-lab",
        "dglab",
        "郊狼",
        "coyote",
        "websocket",
        "脉冲"
      ]
    },
    "operit_bridge": {
      "name": "Operit Bridge 双向工具桥接",
      "description": "让 xiaoli-cli 兼容 Operit AI 的第三方工具格式，支持解析/加载/导出 Operit METADATA 脚本",
      "author": "xiaoli-cli",
      "version": "1.0.0",
      "file": "operit_bridge.py",
      "url": "",
      "docs": "",
      "deps": [],
      "optional_deps": [],
      "keywords": [
        "operit",
        "bridge",
        "桥接",
        "兼容",
        "格式转换",
        "METADATA",
        "插件互通"
      ]
    },
    "onebot": {
      "name": "OneBot v11 QQ 机器人",
      "description": "让 xiaoli-cli 成为 QQ 机器人，连接 go-cqhttp/Lagrange/LLOneBot 等 OneBot 实现",
      "author": "xiaoli-cli-plugins",
      "version": "1.0.0",
      "file": "onebot.py",
      "url": "https://gitee.com/shuiyu1123/xiaoli-cli-plugins/raw/master/onebot/onebot.py",
      "docs": "https://gitee.com/shuiyu1123/xiaoli-cli-plugins/raw/master/onebot/README.md",
      "deps": [
        "websocket-client"
      ],
      "optional_deps": [],
      "keywords": [
        "onebot",
        "qq",
        "机器人",
        "bot",
        "go-cqhttp",
        "lagrange",
        "群聊",
        "私聊"
      ]
    }
  }
}