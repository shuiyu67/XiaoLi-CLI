{
  "api": {
    "engines": {
      "ollama": {
        "api_key": "",
        "base_url": "http://localhost:11434",
        "model": "gemma4:31b",
        "max_token_k": "<input:请输入模型最大token大小(K)>"
      },
      "openai": {
        "api_key": "your-api-key-here",
        "base_url": "https://api.deepseek.com/v1",
        "model": "deepseek-chat"
      }
    }
  },
  "system": {
    "default_engine": "ollama",
    "max_history": 50
  },
  "lspServers": {
    "_说明": "语言服务器（LSP）。键为语言ID或扩展名，值为启动命令。配置后重启即生效，工具 lsp__diagnostics/hover/definition/references/completion 自动可用，且 AI 写/改 .py 文件后会自动触发诊断并注入模型上下文。python 默认用自研本地服务器（jedi 语义 + py_detect 中文诊断，纯本地零安装）；换回 pylsp 则 command 改 \"pylsp\"、args 清空。",
    "python": {
      "command": "python",
      "args": ["-m", "xcli_core.local_lsp_server"],
      "disabled": false
    }
  }
}
